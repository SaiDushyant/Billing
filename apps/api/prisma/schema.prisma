// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  QUOTATION
  INVOICE
  BILL
  DRAFT
}

enum DocumentStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
}

enum UserRole {
  ADMIN
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CANCEL
  IMPORT
  SALE
  PURCHASE
  RETURN
}

enum JournalType {
  SALE
  PAYMENT
  RETURN
  REFUND
  ADJUSTMENT
}

enum AccountType {
  CASH
  BANK
  UPI
  CARD
  RECEIVABLE
  SALES
  GST
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  REFUNDED
  REFUND
}

enum DocumentEventType {
  CREATED
  UPDATED
  CANCELLED
  RETURNED
  PARTIAL_RETURN
  PAYMENT_ADDED
  PAYMENT_REFUNDED
  CONVERTED
  APPROVED
  REJECTED
  REBILLED
}

enum ReturnReason {
  DAMAGED
  CUSTOMER_RETURN
  BILLING_ERROR
  EXPIRED
  OTHER
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  role UserRole @default(CASHIER)

  documents Document[]

  auditLogs AuditLog[]

  journalEntries JournalEntry[]

  documentTimelineEvents DocumentTimeline[]

  createdReturns DocumentItemReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  brands Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id         String @id @default(cuid())
  name       String
  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  brandId     String
  description String?

  brand Brand @relation(fields: [brandId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  sku         String @unique
  barcode     String @unique
  displayName String

  attributes Json

  currentStock Int @default(0)

  mrp Decimal @db.Decimal(10, 2)

  costPrice Decimal @db.Decimal(10, 2)

  profitMargin Decimal @default(0) @db.Decimal(5, 2)

  gstRate Decimal @db.Decimal(5, 2)

  product Product @relation(fields: [productId], references: [id])

  stockMovements StockMovement[]

  documentItems DocumentItem[]

  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([displayName])
}

model Supplier {
  id    String  @id @default(cuid())
  name  String
  phone String?

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id String @id @default(cuid())

  supplierId String

  invoiceNumber String

  totalAmount Decimal @db.Decimal(12, 2)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String
  variantId  String

  quantity Int

  unitCost Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())

  name String

  phone String? @unique

  email String?

  address String?

  gstNumber String?

  documents Document[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Document {
  id String @id @default(cuid())

  type   DocumentType
  status DocumentStatus

  customerId String?

  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerAddress   String?
  customerGSTNumber String?

  subtotal   Decimal @db.Decimal(12, 2)
  gstTotal   Decimal @db.Decimal(12, 2)
  grandTotal Decimal @db.Decimal(12, 2)

  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  dueAmount Decimal @default(0) @db.Decimal(12, 2)

  isPaid Boolean @default(false)

  customer Customer? @relation(fields: [customerId], references: [id])

  // CREATED BY
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id])

  items DocumentItem[]

  payments Payment[]

  journalEntries JournalEntry[]

  timeline DocumentTimeline[]

  itemReturns DocumentItemReturn[]

  // REBILL RELATION
  rebillFromId String?

  rebillFrom Document? @relation("DocumentRebill", fields: [rebillFromId], references: [id])

  rebills Document[] @relation("DocumentRebill")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@index([rebillFromId])
}

model DocumentTimeline {
  id String @id @default(cuid())

  documentId String

  userId String?

  type DocumentEventType

  message String

  metadata Json?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([createdAt])
}

model DocumentItem {
  id String @id @default(cuid())

  documentId String
  variantId  String

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  gstRate Decimal @db.Decimal(5, 2)

  lineTotal Decimal @db.Decimal(12, 2)

  document Document @relation(fields: [documentId], references: [id])

  variant ProductVariant @relation(fields: [variantId], references: [id])

  returns DocumentItemReturn[]

  returnedQuantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([documentId])
}

model DocumentItemReturn {
  id String @id @default(cuid())

  documentId String

  documentItemId String

  quantity Int

  refundAmount Decimal @db.Decimal(12, 2)

  reason ReturnReason

  notes String?

  createdById String?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  documentItem DocumentItem @relation(fields: [documentItemId], references: [id])

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([documentId])
  @@index([documentItemId])
}

model Payment {
  id String @id @default(cuid())

  documentId String

  amount Decimal @db.Decimal(12, 2)

  method String

  status PaymentStatus @default(PAID)

  referenceNumber String?

  notes String?

  isRefunded Boolean @default(false)

  refundAmount Decimal @default(0) @db.Decimal(12, 2)

  refundReason String?

  document Document @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([method])
  @@index([status])
}

model JournalEntry {
  id String @id @default(cuid())

  documentId String?

  type JournalType

  description String?

  totalAmount Decimal @db.Decimal(12, 2)

  createdById String?

  createdAt DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id])

  createdBy User? @relation(fields: [createdById], references: [id])

  lines JournalLine[]

  @@index([documentId])
  @@index([type])
  @@index([createdAt])
}

model JournalLine {
  id String @id @default(cuid())

  entryId String

  account AccountType

  debit Decimal @default(0) @db.Decimal(12, 2)

  credit Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  entry JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@index([account])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action AuditAction

  entityType String

  entityId String?

  oldData Json?

  newData Json?

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model StockMovement {
  id String @id @default(cuid())

  variantId String

  type StockMovementType

  quantity Int

  referenceId String?

  notes String?

  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([type])
  @@index([createdAt])
}
